{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "functions": { "api/sig.js": { "maxDuration": 10 } },
  "headers": [
    { "source": "/play/assets/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=86400" }] },
    { "source": "/media/(.*)", "headers": [{ "key": "Cache-Control", "value": "public, max-age=604800" }] }
  ]
}
